# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Security & Sessions
SESSION_SECRET=change-this-to-a-very-long-and-secure-random-secret-key-min-32-chars
COOKIE_SECRET=change-this-to-another-secure-random-secret-key-min-32-chars

# Database
DATABASE_PATH=./data/server.sqlite

# Android Storage Root (Termux shared storage default)
# On Android / Termux: /storage/emulated/0
# For local development / testing: ./storage
STORAGE_ROOT=/storage/emulated/0

# File Upload Limits
MAX_UPLOAD_SIZE_MB=2048

# Companion Bridge Port (for Android Companion app connection)
COMPANION_PORT=3001
COMPANION_SECRET=companion-pairing-secret-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5
